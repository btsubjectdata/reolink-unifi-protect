# deploy/onvif — copy to .env next to docker-compose.yml and fill in. Never commit .env.
# One stack per camera: copy the folder (or use `docker compose -p <name>`) and change ports.

# --- NVR ---------------------------------------------------------------
NVR_IP=192.168.1.1
# A local Protect user with the Administrator role (token fetched on every start), OR a one-off
# ADOPTION_TOKEN from https://<NVR_IP>/proxy/protect/api/cameras/manage-payload (expires ~60 min).
NVR_USER=
NVR_PASS=
ADOPTION_TOKEN=
# Set to 1 once the camera shows in Protect: reconnect like an adopted camera (--adopted).
ADOPTED=0

# --- camera ------------------------------------------------------------
CAM_IP=192.168.1.50
CAM_USER=            # Tapo: the "Camera Account" from the Tapo app (Settings > Advanced > Camera Account)
CAM_PASS=
CAM_NAME=Driveway
CAM_MAC=AABBCC001122 # 12 hex digits, unique per camera, never change it after adoption
ONVIF_PORT=2020      # Tapo: 2020. Most other brands: 80 or 8080
HI_PATH=stream1      # RTSP paths on the camera. Tapo: stream1 (main) / stream2 (sub)
LO_PATH=stream2
# What the streams really carry — check with:  ffprobe rtsp://user:pass@CAM_IP:554/stream1
HI_CODEC=h264
HI_WIDTH=2560
HI_HEIGHT=1440
HI_FPS=15
LO_CODEC=h264
LO_WIDTH=1280
LO_HEIGHT=720
LO_FPS=15
# Tapo sends PCM (G.711) audio; Protect wants AAC. For a camera that already sends AAC use "-c:v copy -c:a copy".
FFMPEG_ARGS=-c:v copy -ar 32000 -ac 1 -codec:a aac -b:a 32k

# --- identity the proxy presents to Protect (UVC G5 Pro) --------------
MODEL=UVC G5 Pro
SYSID=0xa598
PLATFORM=sav837gw
FW_VERSION=5.5.31
FW_BUILD=92ebf37.260724.1639

# --- detections --------------------------------------------------------
AI_MIN_CONFIDENCE=0.5
AI_CLASSES=person,vehicle,animal

# --- host ports (all services use the host network; change per camera) -
RELAY_PORT=8554      # mediamtx, bound to 127.0.0.1
AI_SINK_PORT=7999    # sidecar -> proxy detections, 127.0.0.1
SNAPSHOT_PORT=8999   # sidecar serves /snapshot.jpg to the proxy, 127.0.0.1
PUSH_PORT=9999       # the CAMERA posts ONVIF events here: must be reachable from the camera
