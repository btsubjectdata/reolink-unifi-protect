# reolink-unifi-protect — NVR settings (shared by every camera).
# Install.command copies this to:  ~/Library/Application Support/reolink-unifi-protect/.env
# Edit THAT copy (EditConfig.command opens it). Never commit or sync the filled-in file.
# Shell syntax: put "double quotes" around any value that has spaces or special characters.
#
# Cameras are separate files next to it:  cameras/<name>.env  (see cameras/example-tapo.env
# and cameras/example-reolink.env). One proxy process runs per camera file.

NVR_IP=192.168.1.1
# Adoption: EITHER a local Protect user (token fetched automatically on every start —
# recommended, survives restarts) OR a one-off ADOPTION_TOKEN (expires ~60 min, from
# https://<NVR_IP>/proxy/protect/api/cameras/manage-payload while logged in).
NVR_USER=
NVR_PASS=
ADOPTION_TOKEN=
