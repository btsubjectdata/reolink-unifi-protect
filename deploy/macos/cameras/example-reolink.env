# Reolink camera with on-board AI -> Protect smart detections (person/vehicle/animal boxes).
CAM_TYPE=reolink

CAM_IP=192.168.1.60
CAM_USER=admin
CAM_PASS=
CAM_NAME="Reolink Floodlight"
CAM_MAC=AABBCC001150   # 12 hex digits, no colons

HI_PATH=h264Preview_01_main
LO_PATH=h264Preview_01_sub
RTSP_TRANSPORT=tcp

# Elite Floodlight WiFi values; Probe.command gives yours.
HI_CODEC=h265
HI_WIDTH=5120
HI_HEIGHT=1552
HI_FPS=20
LO_CODEC=h265
LO_WIDTH=1920
LO_HEIGHT=576
LO_FPS=30
LO_TRANSCODE=1
LO_BITRATE=1M

# Reolink sends AAC already.
FFMPEG_ARGS="-c:v copy -c:a copy"
# (user/password are inserted URL-encoded by run-proxy.sh when SNAPSHOT_URL is left empty for Reolink)
SNAPSHOT_URL=

MODEL="UVC G5 Pro"
SYSID=0xa598
PLATFORM=sav837gw
FW_VERSION=5.5.31
FW_BUILD=92ebf37.260724.1639

# Smart detections. AI_SINK_PORT must be unique per Reolink camera on this Mac.
AI_SINK_PORT=7999
AI_MIN_CONFIDENCE=0.75
AI_CONFIDENCE_OVERRIDES=animal=0.6
AI_CLASSES=person,vehicle,animal

EXTRA_ARGS=

# see example-tapo.env
CONNECT_WITH_TOKEN=1

# see example-tapo.env
RELAY=1
