# One camera = one file in ~/Library/Application Support/reolink-unifi-protect/cameras/<name>.env
# The file name (without .env) is the camera's short id used by the scripts and launchd.
# Shell syntax: "double quotes" around values with spaces.

# rtsp   = any generic RTSP camera, video only (Protect gets no smart detections).
# onvif  = RTSP video + the camera's own person/vehicle/pet detections read over ONVIF events
#          (TP-Link Tapo and most cameras with on-board AI). Event-level only, no moving boxes.
# reolink = RTSP video + Reolink's AI over its Baichuan protocol (moving boxes).
CAM_TYPE=onvif
# ONVIF port (Tapo: 2020; most others: 80 or 8080). Uses CAM_USER/CAM_PASS.
ONVIF_PORT=2020

CAM_IP=192.168.1.50
# Tapo: the "Camera Account" from the Tapo app (camera > Settings > Advanced > Camera Account),
# NOT your TP-Link cloud login.
CAM_USER=
CAM_PASS=
CAM_NAME="Tapo C720 Driveway"
# Locally-administered MAC; identifies the VIRTUAL camera inside Protect. Unique per camera.
CAM_MAC=AABBCC001116   # 12 hex digits, no colons

# RTSP paths. Tapo: stream1 (main) / stream2 (sub). Probe.command verifies them.
HI_PATH=stream1
LO_PATH=stream2
RTSP_TRANSPORT=tcp

# What the camera really sends (Probe.command prints it — copy its numbers here).
# Protect caches these at ADOPTION: change them -> remove camera in Protect -> restart.
HI_CODEC=h264
HI_WIDTH=2560
HI_HEIGHT=1440
HI_FPS=15
LO_CODEC=h264
LO_WIDTH=1280
LO_HEIGHT=720
LO_FPS=15
# 1 = re-encode the sub stream to HEVC on the Mac (only when HI_CODEC=h265 and the
# camera's sub stream is H.264). 0 = pass through.
LO_TRANSCODE=0
LO_BITRATE=1M

# Audio: Protect needs an audio track (it drops a video-only FLV at once). Tapo sends PCM, so
# that already sends AAC use "-c:v copy -c:a copy".
FFMPEG_ARGS="-c:v copy -ar 32000 -ac 1 -codec:a aac -b:a 32k"
# Optional HTTP snapshot URL (Reolink has one; Tapo does not — leave empty and the proxy
# grabs snapshots from RTSP instead).
SNAPSHOT_URL=

# Emulated UniFi model. UVC G5 Pro is H.264+H.265 capable. FW_VERSION should be the release the real
# cameras currently run (Protect shows "Click to Update" otherwise — never click it); latest for sav837gw:
# https://fw-update.ui.com/api/firmware-latest?filter=eq~~platform~~sav837gw&filter=eq~~product~~uvc
MODEL="UVC G5 Pro"
SYSID=0xa598
PLATFORM=sav837gw
FW_VERSION=5.5.31
FW_BUILD=92ebf37.260724.1639

# Smart detections (onvif/reolink). AI_SINK_PORT must be unique per camera on this Mac.
AI_SINK_PORT=7999
AI_MIN_CONFIDENCE=0.5
AI_CLASSES=person,vehicle,animal
# Event thumbnail and clip timing (ONVIF events carry no position and arrive a few
# seconds late). THUMBNAIL_CROP=motion samples the picture for THUMBNAIL_DELAY seconds,
# keeps the frame that changed most and zooms on it (frame = whole frame letterboxed).
# EVENT_LEAD backdates the event start by that many seconds so the clip shows the walk-in.
#THUMBNAIL_CROP=motion
#THUMBNAIL_DELAY=5
#EVENT_LEAD=3

# Extra proxy args, e.g. -v for debug logging.
EXTRA_ARGS=

# Connect with the adoption token (1, default) or like an already-adopted camera (0).
# Protect 7.x: set to 0 once the camera shows in Protect, or smart detections are dropped.
CONNECT_WITH_TOKEN=1

# RELAY=1 (default): read the local mediamtx relay instead of the camera, so Protect can open
# all three of its streams while the camera only ever sees two RTSP sessions. RELAY=0 = direct.
RELAY=1
