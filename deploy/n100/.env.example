# Copy to .env (gitignored) and fill in. Never commit .env.

# --- UniFi Protect ---
NVR_IP=192.168.1.1
# A LOCAL Protect admin made for the bridge (Protect -> Settings -> Admins & Users).
NVR_USER=protect-bridge
NVR_PASS=
# 0 on first run (the proxy fetches an adoption token with the login above and the camera
# appears in Protect for adoption). Set to 1 once adopted, then: docker compose up -d
ADOPTED=0

# --- The camera ---
CAM_IP=192.168.1.50
# A dedicated user on the camera (Reolink app -> Settings -> User Management), admin role
# (the AI/push/spotlight API needs it). Enable RTSP + ONVIF under Network -> Advanced -> Port.
CAM_USER=bridge
CAM_PASS=
# What Protect shows
CAM_NAME=Floodlight
# Any unique 12-hex-digit MAC for the virtual camera (no colons)
CAM_MAC=AABBCC000001

# --- Streams: run probe.sh at the camera's site and paste what it prints ---
# Elite Floodlight WiFi: main 5120x1552 H.265 @ 20 fps, sub 1536x432 (or 1920x576) H.264
HI_WIDTH=5120
HI_HEIGHT=1552
HI_FPS=20
LO_WIDTH=1536
LO_HEIGHT=432
LO_FPS=15

# --- Emulated UniFi camera ---
# Must match the CURRENT G5 Pro release in Protect's firmware catalog, or Protect offers an
# "update" and the camera flaps. Check after every Protect upgrade:
#   https://fw-update.ui.com/api/firmware-latest?filter=eq~~platform~~sav837gw&filter=eq~~product~~uvc
FW_VERSION=5.4.132

# --- Optional ---
# Floodlight on/off from Protect's light action (1 = on). Reboot camera from Protect (1 = on).
SPOTLIGHT=1
REBOOT=1
# Boxes come from the sub stream on the Floodlight (main on doorbells)
AI_SIDECAR_PROFILE=sub
#AI_MIN_CONFIDENCE=0.75
#AI_CONFIDENCE_OVERRIDES=animal=0.6
# Seconds to backdate the event start so the clip includes the walk-in (push events are
# fast on Reolink; 1-2 is plenty)
#EVENT_LEAD=1
#EXTRA_ARGS=-v
TZ=America/Chicago
