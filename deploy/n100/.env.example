# Copy to .env (gitignored) and fill in. Never commit .env.

# --- UniFi Protect ---
NVR_IP=192.168.1.1
# A LOCAL Protect admin made for the bridge (Protect -> Settings -> Admins & Users).
NVR_USER=protect-bridge
NVR_PASS=
# 0 on first run (the proxy fetches an adoption token with the login above and the camera
# appears in Protect for adoption). Set to 1 once adopted, then: docker compose up -d
ADOPTED=0

# --- The camera ---
CAM_IP=192.168.1.50
# A dedicated admin user on the camera (the AI/push/spotlight API needs admin). Newer
# Reolink apps hide User Management; probe.sh can create the user over the camera's API
# (see README). Enable RTSP + ONVIF + HTTPS under More Features -> Advanced Network
# Settings -> Server Settings (older apps: Network -> Advanced -> Port).
CAM_USER=bridge
CAM_PASS=
# What Protect shows
CAM_NAME=Floodlight
# Any unique 12-hex-digit MAC for the virtual camera (no colons)
CAM_MAC=AABBCC000001

# --- Streams: run probe.sh at the camera's site and paste what it prints ---
# Elite Floodlight WiFi (firmware v3.2.0.6011): main 5120x1552 H.265 @ 25 fps,
# sub 1920x576 H.264 @ 25 fps (older firmware: 20 fps and 1536x432)
HI_WIDTH=5120
HI_HEIGHT=1552
HI_FPS=25
LO_WIDTH=1920
LO_HEIGHT=576
LO_FPS=25

# --- Emulated UniFi camera ---
# Must match the CURRENT G5 Pro release in Protect's firmware catalog, or Protect offers an
# "update" and the camera flaps. Check after every Protect upgrade:
#   https://fw-update.ui.com/api/firmware-latest?filter=eq~~platform~~sav837gw&filter=eq~~product~~uvc
FW_VERSION=5.5.31

# GIDs of the host's video and render groups (`getent group video render`), so the
# container may open /dev/dri for Quick Sync
VIDEO_GID=44
RENDER_GID=992

# --- Optional ---
# Passthrough ffmpeg options for the main stream. The Elite Floodlight (WiFi) stamps frames
# unevenly and now and then BACKWARDS; Protect then shows a frame out of order (the clock
# overlay flips back a second, walking legs jitter). This re-times frames onto the 20 fps
# grid and never lets a timestamp go backwards (measured: 8 -> 0 backward steps per 10 s,
# no drift). Use the main stream's real fps in the 4500 (= 90000 / fps) and 2250 (half).
FFMPEG_ARGS='-c:v copy -bsf:v "setts=ts=if(eq(PREV_OUTPTS\,NOPTS)\,PTS\,max(round(PTS/4500)*4500\,PREV_OUTPTS+2250))" -c:a copy'

# Floodlight on/off from Protect's light action (1 = on). Reboot camera from Protect (1 = on).
SPOTLIGHT=1
REBOOT=1
# Boxes come from the sub stream on the Floodlight (main on doorbells)
AI_SIDECAR_PROFILE=sub
# Which stream the snapshots/thumbnails come from: main (5K, ~1.6 MB each) or sub
#SNAPSHOT_STREAM=main
#AI_MIN_CONFIDENCE=0.75
#AI_CONFIDENCE_OVERRIDES=animal=0.6
# Seconds to keep an event open after the camera's AI flag drops. The floodlight's 2026
# firmware pulses the flag for ~1 s per detection, which is too short for the box sidecar
#PUSH_HOLD=5
# Seconds to backdate the event start so the clip includes the walk-in (push events are
# fast on Reolink; 1-2 is plenty)
#EVENT_LEAD=1
#EXTRA_ARGS=-v
TZ=America/Chicago
