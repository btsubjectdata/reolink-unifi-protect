# One file per camera in cameras/<name>.env (gitignored except this example). bridge.sh runs
# the compose once per file, as project <name>. Ports must be unique per camera on this host.

# --- Protect ---
NVR_IP=192.168.1.1
# Local Protect admin for the bridge (or ADOPTION_TOKEN= from the NVR's manage-payload URL)
NVR_USER=protect-bridge
NVR_PASS=
# 0 until the camera shows up in Protect and you adopt it; then 1 and `bridge.sh up`
ADOPTED=0

# --- Camera (Tapo: the Camera Account from the Tapo app, Settings > Advanced > Camera Account) ---
CAM_IP=192.168.1.50
CAM_USER=
CAM_PASS=
CAM_NAME=Driveway
# 12 hex digits, unique, NEVER change after adoption (Protect keys the camera on it)
CAM_MAC=AABBCC001122
ONVIF_PORT=2020
HI_PATH=stream1
LO_PATH=stream2

# --- Streams, as the camera really serves them (ffprobe them) ---
HI_CODEC=h264
HI_WIDTH=2560
HI_HEIGHT=1440
HI_FPS=15
LO_CODEC=h264
LO_WIDTH=1280
LO_HEIGHT=720
LO_FPS=15
# 16 kHz AAC matches what the proxy advertises (32 kHz breaks Safari live view). Add
# "-bsf:v filter_units=remove_types=6" if the log shows "SEI type ... truncated".
FFMPEG_ARGS=-c:v copy -ar 16000 -ac 1 -codec:a aac -b:a 32k

# --- Emulated camera. FW_VERSION must match Protect's current G5 Pro release ---
FW_VERSION=5.5.31

# --- Ports: all on 127.0.0.1 except PUSH_PORT, which the camera posts events to ---
RELAY_PORT=8554
AI_SINK_PORT=7999
SNAPSHOT_PORT=8999
PUSH_PORT=9999
# second camera: 8555 / 7998 / 8998 / 9998, and so on

# --- Tuning (defaults shown) ---
#AI_MIN_CONFIDENCE=0.5
#THUMBNAIL_CROP=motion
#THUMBNAIL_DELAY=5
#EVENT_LEAD=5
#ONVIF_HOLD=3
#AI_CLEAR_AFTER=1
TZ=America/Chicago
